{
  "name": "openresume-builder",
  "version": "2.2.6",
  "description": "OpenResume Builder — open-source browser-first resume builder",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
